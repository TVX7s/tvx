local indicatorRotatedState = false
local function ToggleBenxIndicatorRotation()
    indicatorRotatedState = not indicatorRotatedState
    local targetRot = indicatorRotatedState and 180 or 0
    local rotTween = TweenService:Create(BenxIndicator, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {Rotation = targetRot})
    rotTween:Play()
end

local function StopBenxFeature()
    if getgenv().Benxme then
        getgenv().Benxme = false
        BenxIndicator.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
        ToggleBenxIndicatorRotation()
        pcall(function()
            if savedMyCFrame and Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                Players.LocalPlayer.Character.HumanoidRootPart.CFrame = savedMyCFrame
            end
            if Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("Humanoid") then
                Players.LocalPlayer.Character.Humanoid.Sit = false
            end
        end)
    end
end

BenxButton.MouseButton1Click:Connect(function()
    local targetNameText = additionalParent.Text
    if targetNameText == "" then
        ShowTVXNotification("TVX System", "لازم تكتب اسم الشخص عشان تقدر تستهدفه")
        return
    end

    local player = GetPlayer(targetNameText)
    if not player then
        ShowTVXNotification("TVX System", "لازم تكتب اسم الشخص عشان تقدر تستهدفه")
        return
    end

    if not getgenv().Benxme then
        local displayValue = targetNameText
        local secondaryDisplayValue = ""
        local target = GetPlayerV2(tostring(secondaryDisplayValue))
        if secondaryDisplayValue == "" or target == game.Players.LocalPlayer then
            pcall(function()
                if Players.LocalPlayer.Character and Players.LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    savedMyCFrame = Players.LocalPlayer.Character.HumanoidRootPart.CFrame
                end
            end)
            getgenv().Benxme = true
            spawn(function()
                local sum = -2
                local sumNumber = 0.1
                local number = -1

                while getgenv().Benxme do
                    pcall(function()
                        local cFrameOption = player.Character:FindFirstChild("Torso") or player.Character:FindFirstChild("UpperTorso")
                        if cFrameOption.Name == "Torso" then
                            number = -0.75
                        end

                        game.Players.LocalPlayer.Character.Humanoid.Sit = true
                        game.Players.LocalPlayer.Character.HumanoidRootPart.CFrame = cFrameOption.CFrame * CFrame.new(0, number, sum) * CFrame.Angles(math.rad(270), 0, 0)
                        game.Players.LocalPlayer.Character.HumanoidRootPart.Velocity = Vector3.new(0, 0, 0)
                        sum = sum + sumNumber

                        if sum >= -1 or sum <= -2 then
                            sumNumber = -sumNumber
                        end
                    end)
                    task.wait()
                end

                pcall(function()
                    game.Players.LocalPlayer.Character.Humanoid.Sit = false
                end)
            end)
        end
        BenxIndicator.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
        ToggleBenxIndicatorRotation()
    else
        StopBenxFeature()
    end
end)

local function ResetTargetData()
    targetPlayerGlobal = nil
    additionalParent.Text = ""
    secondaryValueLabel.Text = "UserID: \n\nUser: \n\nJoined: "
    secondaryImageLabel.Image = "rbxassetid://10818605405"
end

local function ProcessTarget(inputName)
    local query = string.lower(inputName or "")
    query = query:gsub("^@", "")
    query = query:gsub("%s+", "")
    
    local targetPlayer = nil
    
    if query == "ahmed" or query == "ahm" or query == "ah" or query == "a" then
        for _, p in ipairs(Players:GetPlayers()) do
            local pName = string.lower(p.Name)
            local pDisp = string.lower(p.DisplayName)
            if pName:find("ahmed") or pDisp:find("ahmed") or pName:find("ahm") or pDisp:find("ahm") or pName:find("ah") or pDisp:find("ah") or pName:find("a") or pDisp:find("a") then
                targetPlayer = p
                break
            end
        end
        if not targetPlayer and #Players:GetPlayers() > 0 then
            targetPlayer = Players:GetPlayers()[1]
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            local pName = string.lower(p.Name)
            local pDisp = string.lower(p.DisplayName)
            if pName == query or pDisp == query or pName:find(query) or pDisp:find(query) then
                targetPlayer = p
                break
            end
        end
    end
    
    targetPlayerGlobal = targetPlayer
    
    if targetPlayer then
        local userId = targetPlayer.UserId
        local realName = targetPlayer.Name
        local success, days = pcall(function()
            return targetPlayer.AccountAge
        end)
        
        local currentTimestamp = os.time()
        local approxSecondsPerDay = 86400
        local estimatedCreationTimestamp = currentTimestamp - ((days or 0) * approxSecondsPerDay)
        local dateTable = os.date("*t", estimatedCreationTimestamp)
        
        local yearFormatted = dateTable.year
        local monthFormatted = dateTable.month
        local dayFormatted = dateTable.day
        
        secondaryValueLabel.Text = "UserID: " .. userId .. "\n\nUser: " .. realName .. "\n\nJoined: [ " .. yearFormatted .. " / " .. monthFormatted .. " / " .. dayFormatted .. " ]"
        
        pcall(function()
            local content = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            secondaryImageLabel.Image = content
        end)
    else
        secondaryValueLabel.Text = "UserID: \n\nUser: \n\nJoined: "
    end
end

additionalParent.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        ProcessTarget(additionalParent.Text)
    end
end)

