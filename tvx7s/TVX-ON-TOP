local function ShowTVXNotification(titleText, bodyText, targetUserId)
    local NotifFrame = Instance.new("Frame")
    NotifFrame.Parent = NotificationContainer
    NotifFrame.BackgroundColor3 = Color3.fromRGB(15, 5, 25)
    NotifFrame.BackgroundTransparency = 0.2
    NotifFrame.Size = UDim2.new(1, 0, 0, 65)
    NotifFrame.Position = UDim2.new(1, 50, 0, 0)
    NotifFrame.ZIndex = 101

    local NotifCorner = Instance.new("UICorner")
    NotifCorner.CornerRadius = UDim.new(0, 12)
    NotifCorner.Parent = NotifFrame

    CreateAnimatedStroke(NotifFrame)

    local TitleLabel = Instance.new("TextLabel")
    TitleLabel.Parent = NotifFrame
    TitleLabel.BackgroundTransparency = 1
    TitleLabel.Position = UDim2.new(0, 12, 0, 8)
    TitleLabel.Size = UDim2.new(1, -24, 0, 20)
    TitleLabel.Font = Enum.Font.GothamBold
    TitleLabel.Text = titleText
    TitleLabel.TextColor3 = Color3.fromRGB(180, 100, 255)
    TitleLabel.TextSize = 13
    TitleLabel.TextXAlignment = Enum.TextXAlignment.Left
    TitleLabel.ZIndex = 102

    local BodyLabel = Instance.new("TextLabel")
    BodyLabel.Parent = NotifFrame
    BodyLabel.BackgroundTransparency = 1
    BodyLabel.Position = UDim2.new(0, 12, 0, 28)
    BodyLabel.Size = UDim2.new(1, targetUserId and -65 or -24, 0, 30)
    BodyLabel.Font = Enum.Font.Gotham
    BodyLabel.Text = bodyText
    BodyLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    BodyLabel.TextSize = 11
    BodyLabel.TextWrapped = true
    BodyLabel.TextXAlignment = Enum.TextXAlignment.Left
    BodyLabel.ZIndex = 102

    if targetUserId then
        local NotifImage = Instance.new("ImageLabel")
        NotifImage.Parent = NotifFrame
        NotifImage.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        NotifImage.BackgroundTransparency = 0.2
        NotifImage.Position = UDim2.new(1, -52, 0, 12)
        NotifImage.Size = UDim2.new(0, 40, 0, 40)
        NotifImage.ZIndex = 102

        local NotifImgCorner = Instance.new("UICorner")
        NotifImgCorner.CornerRadius = UDim.new(0, 8)
        NotifImgCorner.Parent = NotifImage

        CreateAnimatedStroke(NotifImage)

        pcall(function()
            local content = Players:GetUserThumbnailAsync(targetUserId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
            NotifImage.Image = content
        end)
    end

    local Sound = Instance.new("Sound")
    Sound.Parent = NotifFrame
    Sound.SoundId = "rbxassetid://9900000000"
    Sound.Volume = 1
    pcall(function()
        Sound:Play()
    end)

    local slideIn = TweenService:Create(NotifFrame, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0, 0, 0, 0)})
    slideIn:Play()

    task.delay(3, function()
        local slideOut = TweenService:Create(NotifFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {Position = UDim2.new(1, 50, 0, 0)})
        slideOut:Play()
        slideOut.Completed:Wait()
        NotifFrame:Destroy()
    end)
end

