local function GetPlayer(nameInput)
    local query = string.lower(nameInput or "")
    query = query:gsub("^@", "")
    query = query:gsub("%s+", "")
    if query == "" then return nil end
    for _, p in ipairs(Players:GetPlayers()) do
        local pName = string.lower(p.Name)
        local pDisp = string.lower(p.DisplayName)
        if pName == query or pDisp == query or pName:find(query) or pDisp:find(query) then
            return p
        end
    end
    return nil
end

local function GetPlayerV2(nameInput)
    local query = string.lower(nameInput or "")
    query = query:gsub("^@", "")
    query = query:gsub("%s+", "")
    if query == "" then return Players.LocalPlayer end
    for _, p in ipairs(Players:GetPlayers()) do
        local pName = string.lower(p.Name)
        local pDisp = string.lower(p.DisplayName)
        if pName == query or pDisp == query or pName:find(query) or pDisp:find(query) then
            return p
        end
    end
    return Players.LocalPlayer
end

