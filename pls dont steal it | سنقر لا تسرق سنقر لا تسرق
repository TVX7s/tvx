local function SetOnline()
    pcall(function()
        getgenv().online = nil
        local success, response = pcall(function()
            local requestData = {
                Url = "https://counter-7sone.onrender.com/counter",
                Method = "GET"
            }
            return request(requestData)
        end)

        if success and response and response.Body then
            local decoded = game:GetService("HttpService"):JSONDecode(response.Body)
            for _, item in pairs(decoded) do
                if type(item) == "number" then
                    getgenv().online = tostring(item)
                    break
                elseif type(item) == "string" then
                    local num = item:match("%d")
                    if num then
                        getgenv().online = num
                        break
                    end
                end
            end
        end

        if getgenv().TVX and getgenv().TVX.Background and getgenv().TVX.Background.Home_Section and getgenv().TVX.Background.Home_Section.Announce_Label_Frame and getgenv().TVX.Background.Home_Section.Announce_Label_Frame.Title2 then
            getgenv().TVX.Background.Home_Section.Announce_Label_Frame.Title2.Text = tostring(utf8.char(128994) .. " " .. (getgenv().online or "0"))
        end
    end)
end

