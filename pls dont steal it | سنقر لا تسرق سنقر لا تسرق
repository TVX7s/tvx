local function ResetTargetData()
    targetPlayerGlobal = nil
    additionalParent.Text = ""
    secondaryValueLabel.Text = "UserID: -\nUser: -\nJoined: -"
    secondaryImageLabel.Image = "rbxassetid://10818605405"
end

local function ProcessTarget(inputName)
    local query = string.lower(inputName or "")
    query = query:gsub("^@", "")
    query = query:gsub("%s+", "")
    
    local targetPlayer = nil
    
    if query == "ahmed" or query == "ahm" or query == "ah" or query == "a" then
        for _, p in ipairs(Players:GetPlayers()) do
            local pName = string.lower(p.Name)
            local pDisp = string.lower(p.DisplayName)
            if pName:find("ahmed") or pDisp:find("ahmed") or pName:find("ahm") or pDisp:find("ahm") or pName:find("ah") or pDisp:find("ah") or pName:find("a") or pDisp:find("a") then
                targetPlayer = p
                break
            end
        end
        if not targetPlayer and #Players:GetPlayers() > 0 then
            targetPlayer = Players:GetPlayers()[1]
        end
    else
        for _, p in ipairs(Players:GetPlayers()) do
            local pName = string.lower(p.Name)
            local pDisp = string.lower(p.DisplayName)
            if pName == query or pDisp == query or pName:find(query) or pDisp:find(query) then
                targetPlayer = p
                break
            end
        end
    end
    
    targetPlayerGlobal = targetPlayer
    
    if targetPlayer then
        local userId = targetPlayer.UserId
        local realName = targetPlayer.Name
        local success, days = pcall(function()
            return targetPlayer.AccountAge
        end)
        
        local currentTimestamp = os.time()
        local approxSecondsPerDay = 86400
        local estimatedCreationTimestamp = currentTimestamp - ((days or 0) * approxSecondsPerDay)
        local dateTable = os.date("*t", estimatedCreationTimestamp)
        
        local yearFormatted = dateTable.year
        local monthFormatted = dateTable.month
        local dayFormatted = dateTable.day
        
        secondaryValueLabel.Text = "UserID: " .. userId .. "\nUser: "  .. realName .. "\nJoined: [ " .. yearFormatted .. " / " .. monthFormatted .. " / " .. dayFormatted .. " ]"
        
        task.spawn(function()
            pcall(function()
                local content = Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
                secondaryImageLabel.Image = content
            end)
        end)
    else
        secondaryValueLabel.Text = "UserID: -\nUser: -\nJoined: -"
    end
end

