FlingButton.MouseButton1Click:Connect(function()
    local targetNameText = additionalParent.Text
    if targetNameText == "" then
        ShowTVXNotification("TVX", "لازم تكتب اسم الشخص عشان تقدر تستهدفه")
        return
    end

    local targetPlayer = GetPlayer(targetNameText)
    if not targetPlayer then
        ShowTVXNotification("TVX", "لازم تكتب اسم الشخص عشان تقدر تستهدفه")
        return
    end

    if not getgenv().FlingingActive then
        StopBenxFeature()
        StopWatchFeature()
        StopHearFeature()
        StopBangedFeature()
        getgenv().FlingingActive = true
        FlingIndicator.BackgroundColor3 = Color3.fromRGB(50, 255, 50)
        ToggleFlingIndicatorRotation()

        task.spawn(function()
            local Player = Players.LocalPlayer
            local Character = Player.Character
            local Humanoid = Character and Character:FindFirstChildOfClass("Humanoid")
            local RootPart = Humanoid and Humanoid.RootPart

            if Character and Humanoid and RootPart then
                if RootPart.Velocity.Magnitude < 50 then
                    savedMyCFrame = RootPart.CFrame
                end

                local FPos = function(BasePart, Pos, Ang)
                    if RootPart and Character then
                        RootPart.CFrame = CFrame.new(BasePart.Position) * Pos * Ang
                        Character:SetPrimaryPartCFrame(CFrame.new(BasePart.Position) * Pos * Ang)
                        RootPart.Velocity = Vector3.new(9e7, 9e7 * 10, 9e7)
                        RootPart.RotVelocity = Vector3.new(9e8, 9e8, 9e8)
                    end
                end

                local BV = Instance.new("BodyVelocity")
                BV.Name = "EpixVel"
                BV.Parent = RootPart
                BV.Velocity = Vector3.new(9e8, 9e8, 9e8)
                BV.MaxForce = Vector3.new(1/0, 1/0, 1/0)

                Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, false)

                while getgenv().FlingingActive and targetPlayer and targetPlayer.Character do
                    local TCharacter = targetPlayer.Character
                    local THumanoid = TCharacter:FindFirstChildOfClass("Humanoid")
                    local TRootPart = THumanoid and THumanoid.RootPart
                    local THead = TCharacter:FindFirstChild("Head")

                    if THead then
                        workspace.CurrentCamera.CameraSubject = THead
                    elseif THumanoid and TRootPart then
                        workspace.CurrentCamera.CameraSubject = THumanoid
                    end

                    if TRootPart then
                        local Angle = tick() * 500
                        FPos(TRootPart, CFrame.new(0, 1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                        FPos(TRootPart, CFrame.new(0, -1.5, 0) + THumanoid.MoveDirection, CFrame.Angles(math.rad(Angle), 0, 0))
                        task.wait()
                    else
                        task.wait()
                    end
                end

                BV:Destroy()
                Humanoid:SetStateEnabled(Enum.HumanoidStateType.Seated, true)
                workspace.CurrentCamera.CameraSubject = Humanoid

                if savedMyCFrame then
                    local startTime = tick()
                    while getgenv().FlingingActive == false and tick() - startTime < 2 do
                        RootPart.CFrame = savedMyCFrame * CFrame.new(0, .5, 0)
                        Character:SetPrimaryPartCFrame(savedMyCFrame * CFrame.new(0, .5, 0))
                        Humanoid:ChangeState("GettingUp")
                        for _, x in ipairs(Character:GetChildren()) do
                            if x:IsA("BasePart") then
                                x.Velocity, x.RotVelocity = Vector3.new(), Vector3.new()
                            end
                        end
                        task.wait()
                        if (RootPart.Position - savedMyCFrame.p).Magnitude < 25 then
                            break
                        end
                    end
                end
            end
            StopFlingFeature()
        end)
    else
        StopFlingFeature()
    end
end)

